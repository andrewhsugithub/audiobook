DATABASE_URL=<YOUR_DATABASE_URL>
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<YOUR_DATABASE_URL>
HYPERDRIVE_ID=<YOUR_HYPERDRIVE_ID>

S3_ENDPOINT=<YOUR_S3_ENDPOINT>
S3_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_ACCESS_KEY>
SUPABASE_PROJECT_ID=<YOUR_SUPABASE_PROJECT_ID> # if using supabase as storage provider

# change if use local tts or other providers
TTS_URL=https://api.cartesia.ai/tts/bytes
TTS_API_KEY=<YOUR_CARTESIA_API_KEY>

# currently only tested using supabase
STORAGE_PROVIDER=supabase

# currently don't need
LLM_URL=<CLOUDFLARE_ENDPOINT>
CLOUDFLARE_ACCOUNT_ID=<YOUR_CLOUDFLARE_ACCOUNT_ID>
LLM_API_TOKEN=<YOUR_CLOUDFLARE_API_TOKEN>

# for github actions
GITHUB_OWNER=<YOUR_GITHUB_USERNAME>
GITHUB_REPO=<YOUR_GITHUB_REPO>
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>

# for jwt signing
TOKEN_SECRET=<YOUR_JWT_SECRET>

VITE_API_BASE_URL=http://localhost:8787